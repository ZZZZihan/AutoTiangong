CAMPUS_NET_USERNAME=replace-with-primary-authorized-account
CAMPUS_NET_PASSWORD=replace-with-primary-password
CAMPUS_NET_USERNAME_2=replace-with-secondary-authorized-account
CAMPUS_NET_PASSWORD_2=replace-with-secondary-password

# Optional compact account pool when login.accounts is omitted from config.
# Format: account_id:username_env:password_env,account_id_2:username_env_2:password_env_2
AUTOTIANGONG_ACCOUNTS=

# Optional notifications. Keep real URLs and tokens out of git.
AUTOTIANGONG_WECOM_WEBHOOK=
AUTOTIANGONG_DINGTALK_WEBHOOK=
AUTOTIANGONG_TELEGRAM_WEBHOOK=
AUTOTIANGONG_TELEGRAM_CHAT_ID=
AUTOTIANGONG_SMTP_HOST=
AUTOTIANGONG_SMTP_USERNAME=
AUTOTIANGONG_SMTP_PASSWORD=
AUTOTIANGONG_EMAIL_FROM=
AUTOTIANGONG_EMAIL_TO=
